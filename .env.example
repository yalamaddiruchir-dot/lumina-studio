# ============================================================
# Lumina Studios — environment configuration (Spring Boot + MySQL)
# Copy to .env and edit:   cp .env.example .env
# ============================================================

# --- Runtime ---
PORT=3001

# --- Security (REQUIRED in production) ---
# Generate one:  openssl rand -hex 32
JWT_SECRET=

# Comma-separated list of allowed browser origins for the API (optional;
# the built frontend is served by the same process, so same-origin works).

# --- Database (MySQL / MariaDB) ---
MYSQL_DATABASE=lumina
MYSQL_USER=lumina
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Demo data ---
# NEVER true in production — demo accounts with password "demo123" would give
# anyone owner access to the company's data.
SEED_DEMO=false

# --- First account (production, on first boot with an empty DB) ---
# Set these BEFORE the first `docker compose up` to auto-create the initial
# Owner account. Password must be at least 8 characters.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=owner

# --- Domain (used by the optional Caddy HTTPS proxy) ---
# e.g. app.company.com  (DNS A record must point at this server)
DOMAIN=

# --- Backups ---
BACKUP_DIR=backups
BACKUP_KEEP=30
